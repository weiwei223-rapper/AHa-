# PostgreSQL 資料庫配置
# 格式: postgresql+psycopg://用戶名:密碼@主機:端口/資料庫名
DATABASE_URL=postgresql+psycopg://aha_user:aha_password@localhost:5432/aha

# JWT 密鑰 (用於令牌加密)
JWT_SECRET=your-secret-key-change-this-in-production

# API 主機和端口
API_HOST=127.0.0.1
API_PORT=8000

# 日誌級別 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
